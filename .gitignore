# Credentials - never commit these
.env

# Virtual environment
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# SQLite working files (the database itself IS committed - see below)
*.db-journal
*.db-wal
*.db-shm
*.db.backup

# OS
.DS_Store
Thumbs.db

# The app reads espn_league.db at runtime and Streamlit Community Cloud has no
# persistent disk, so the database must stay tracked in git.
!espn_league.db
